<Window x:Class="BbsNavigator.Views.LoginSequenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
        Title="Login steps" Width="760" Height="480" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        mosaic:WindowChromeBehavior.IsEnabled="True" mosaic:WindowChromeBehavior.CaptionHeight="0"
        Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}">
    <DockPanel Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
        <mosaic:WindowTitleBar DockPanel.Dock="Top" ShowMinimizeButton="False" />
        <StackPanel DockPanel.Dock="Top" Margin="16,12">
            <TextBlock Text="Wait for a prompt, then send a response" FontSize="20" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Prompts match literal text without case sensitivity. Seconds sets a wait timeout or delay. Use SendUsername and SendPassword for saved credentials; Enter is a separate step." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Save steps" IsDefault="True" Click="Save_OnClick" MinWidth="100" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,8,16,0">
            <Button Content="Add step" Click="Add_OnClick" Padding="10,4" />
            <Button Content="Remove" Click="Remove_OnClick" Margin="8,0" Padding="10,4" />
            <Button Content="Move up" Click="Up_OnClick" Padding="10,4" />
            <Button Content="Move down" Click="Down_OnClick" Margin="8,0" Padding="10,4" />
        </StackPanel>
        <DataGrid x:Name="StepsGrid" Margin="16,0" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="False" SelectionMode="Single" ItemsSource="{Binding Steps}">
            <DataGrid.Columns>
                <DataGridComboBoxColumn x:Name="ActionColumn" Header="Action" Width="150" SelectedItemBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Prompt or literal text" Width="*" MinWidth="280" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Seconds" Width="90" Binding="{Binding Seconds, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
