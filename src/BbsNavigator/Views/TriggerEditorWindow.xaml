<Window x:Class="BbsNavigator.Views.TriggerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
        xmlns:scripting="clr-namespace:Mosaic.UI.Wpf.Scripting;assembly=Mosaic.UI.Wpf"
        Title="Edit trigger" Width="1000" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        mosaic:WindowChromeBehavior.IsEnabled="True" mosaic:WindowChromeBehavior.CaptionHeight="0"
        Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}">
    <DockPanel Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
        <mosaic:WindowTitleBar DockPanel.Dock="Top" ShowMinimizeButton="False" />
        <StackPanel DockPanel.Dock="Bottom" Margin="16" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0,0,8,0" Padding="10,4" />
            <Button Content="Save" Click="Save_OnClick" MinWidth="100" Padding="10,4" />
        </StackPanel>
        <Grid Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Trigger" FontWeight="SemiBold" />
                    <TextBox x:Name="TriggerTextBox" Margin="0,4,0,0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A descriptive name for the trigger." />

                    <TextBlock Margin="0,12,0,0" Text="Pattern" FontWeight="SemiBold" />
                    <TextBox Margin="0,4,0,0" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="A case-sensitive .NET regular expression matched against complete lines without ANSI codes." />

                    <TextBlock Margin="0,12,0,0" Text="Priority" FontWeight="SemiBold" />
                    <TextBox Margin="0,4,0,0" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Lower numbers are processed first." />

                    <CheckBox Margin="0,14,0,0" Content="Enabled" IsChecked="{Binding Enabled}" />

                    <CheckBox Margin="0,12,0,0" Content="Disable after firing" IsChecked="{Binding DisableAfterTriggered}" />

                    <TextBlock Margin="0,14,0,0" Text="{Binding Count, StringFormat='Used {0:N0} times'}" />

                    <TextBlock Margin="0,20,0,0" Text="Script" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" xml:space="preserve">%0 is the entire received line; %1, %2, … are regex capture groups. Use %army for a named group such as (?&lt;army&gt;\w+). Names are case-sensitive; missing groups become empty strings. Place captures inside quoted strings. Use %% for a literal percent sign.

term is the terminal that fired the trigger:
  term.SendLine("look");
  term.Echo("Captured: %1");

Ctrl+Space shows completions.</TextBlock>
                </StackPanel>
            </ScrollViewer>

            <mosaic:ScriptEditorControl x:Name="ScriptEditor" Grid.Column="2"
                                           ToolBarVisibility="Collapsed"
                                           Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
    </DockPanel>
</Window>
