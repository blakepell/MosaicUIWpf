<Window x:Class="BbsNavigator.Views.TextSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
        Title="Review text before sending" Width="720" Height="540" MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        mosaic:WindowChromeBehavior.IsEnabled="True" mosaic:WindowChromeBehavior.CaptionHeight="0"
        Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
        Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}">
    <DockPanel Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
        <mosaic:WindowTitleBar DockPanel.Dock="Top" ShowMinimizeButton="False" />
        <StackPanel DockPanel.Dock="Top" Margin="16,12">
            <TextBlock x:Name="DestinationText" FontSize="18" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="Make sure the BBS is ready to receive this text. Line breaks send Enter keys. You can edit the preview before sending." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,10">
            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
                <TextBlock Text="Character delay (ms):" VerticalAlignment="Center" />
                <TextBox x:Name="CharacterDelayBox" Width="60" Margin="8,0,16,0" AutomationProperties.Name="Character delay in milliseconds" />
                <TextBlock Text="Extra line delay (ms):" VerticalAlignment="Center" />
                <TextBox x:Name="LineDelayBox" Width="60" Margin="8,0" AutomationProperties.Name="Line delay in milliseconds" />
            </WrapPanel>
            <CheckBox x:Name="RememberPacing" Content="Remember these delays for this board" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
                <Button x:Name="SendButton" Content="Send text" Click="Send_OnClick" MinWidth="90" />
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="PreviewBox" Margin="16,0" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" TextChanged="Preview_OnTextChanged" AutomationProperties.Name="Text to send" />
    </DockPanel>
</Window>
