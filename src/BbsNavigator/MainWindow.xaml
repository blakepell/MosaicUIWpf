<Window
    x:Class="BbsNavigator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ad="https://github.com/blakepell/MosaicUIWpf"
    xmlns:common="clr-namespace:BbsNavigator.Common"
    xmlns:converters="clr-namespace:BbsNavigator.Converters"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:models="clr-namespace:BbsNavigator.Models"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:views="clr-namespace:BbsNavigator.Views"
    Title="BBS Navigator"
    Width="1280"
    Height="820"
    MinWidth="900"
    MinHeight="600"
    mosaic:WindowChromeBehavior.CaptionHeight="0"
    mosaic:WindowChromeBehavior.CornerRadius="10"
    mosaic:WindowChromeBehavior.GlassFrameThickness="0"
    mosaic:WindowChromeBehavior.IsEnabled="True"
    mosaic:WindowChromeBehavior.ResizeBorderThickness="5"
    mosaic:WindowChromeBehavior.RoundBorder="True"
    mosaic:WindowChromeBehavior.UseAeroCaptionButtons="True"
    Activated="MainWindow_OnActivated"
    Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
    BorderThickness="0"
    Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}"
    Loaded="MainWindow_OnLoaded"
    PreviewKeyDown="MainWindow_OnPreviewKeyDown"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="36" />
            <RowDefinition x:Name="MenuRow" Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <mosaic:WindowTitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            IconSource="pack://application:,,,/BbsNavigator;component/Assets/app.png"
            IsStretchButtonVisible="True"
            ShowIcon="True"
            TitleAlignment="Center"
            TitleText="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <mosaic:WindowTitleBar.RightContent>
                <Button
                    Width="48"
                    Click="ToggleTheme_OnClick"
                    Content="◐"
                    FontSize="17"
                    Style="{DynamicResource {x:Static mosaic:MosaicTheme.WindowTitleBarButtonStyle}}"
                    ToolTip="Toggle between the blue, light and dark themes" />
            </mosaic:WindowTitleBar.RightContent>
        </mosaic:WindowTitleBar>

        <Menu
            x:Name="AppMenu"
            Grid.Row="1"
            Margin="4,0,4,0"
            Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
            <MenuItem Header="_File">
                <MenuItem
                    Click="ConnectSelected_OnClick"
                    Header="_Connect"
                    InputGestureText="Enter">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/network-connecting-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="DisconnectSelected_OnClick" Header="_Disconnect">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/network-disconnected2-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="RecentConnectionsMenuItem"
                    Header="_Recent Connections"
                    SubmenuOpened="RecentConnections_OnSubmenuOpened">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/network-connecting-48.png" />
                    </MenuItem.Icon>
                    <MenuItem Header="(None)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Click="SaveSettings_OnClick" Header="_Save Settings">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/save2-32.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="BackupSettings_OnClick" Header="_Backup Settings">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/archive-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="Exit_OnClick" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Transfer">
                <MenuItem Click="DownloadFile_OnClick" Header="_Download Files…">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/down-arrow-purple-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="UploadFile_OnClick" Header="_Upload Files…">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/up-arrow-purple-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="OpenDownloadFolder_OnClick" Header="_Open Download Folder">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/downloads-folder-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Terminal" SubmenuOpened="TerminalMenu_OnSubmenuOpened">
                <MenuItem Click="ComposeMessage_OnClick" Header="_Compose Message…" />
                <MenuItem Click="StopSending_OnClick" Header="Stop Sending Text" />
                <MenuItem Click="StopAliasScripts_OnClick" Header="Stop _Alias Scripts" />
                <Separator />
                <MenuItem Click="ToggleDoorway_OnClick" Header="Toggle _DoorWay Mode" />
                <MenuItem Click="ToggleKeypadNavigation_OnClick" Header="Toggle _Keypad Arrows" />
                <MenuItem Click="ToggleScrollbackLock_OnClick" Header="Toggle Scrollback _Lock" />
                <!--  DataContext is the active session's profile, assigned when the menu opens.  -->
                <MenuItem
                    x:Name="CaptureMenuItem"
                    Click="ToggleCapture_OnClick"
                    Header="Toggle Session _Capture"
                    IsChecked="{Binding CaptureSession, Mode=OneWay}" />
                <MenuItem Click="SearchTerminal_OnClick" Header="_Search Screen and Scrollback…" />
                <Separator />
                <MenuItem Click="SendLogin_OnClick" Header="Send Login _Macro" />
                <MenuItem Click="SendUserName_OnClick" Header="Send Saved _Username" />
                <MenuItem Click="SendPassword_OnClick" Header="Send Saved _Password" />
                <Separator />
                <MenuItem
                    x:Name="FullScreenMenuItem"
                    Click="ToggleFullScreen_OnClick"
                    Header="_Full Screen"
                    InputGestureText="Alt+Enter" />
            </MenuItem>
            <MenuItem Header="_Directory">
                <MenuItem
                    Click="AddBbs_OnClick"
                    Header="_Add BBS…"
                    InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/add-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="ImportBbsList_OnClick" Header="_Import BBS List File…" />
                <MenuItem Click="ImportBigList_OnClick" Header="Import _Big List" />
                <MenuItem Click="BrowseBigList_OnClick" Header="Bro_wse Big List…" />
                <Separator />
                <MenuItem Click="EditBbs_OnClick" Header="_Edit BBS…">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/edit-property-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Click="RemoveBbs_OnClick" Header="_Remove BBS">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/minus-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Theme">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/theme2-48.png" />
                    </MenuItem.Icon>
                    <MenuItem
                        x:Name="LightThemeMenuItem"
                        Click="LightTheme_OnClick"
                        Header="_Light"
                        IsCheckable="True" />
                    <MenuItem
                        x:Name="DarkThemeMenuItem"
                        Click="DarkTheme_OnClick"
                        Header="_Dark"
                        IsCheckable="True" />
                    <MenuItem
                        x:Name="BlueThemeMenuItem"
                        Click="BlueTheme_OnClick"
                        Header="_Blue"
                        IsCheckable="True" />
                </MenuItem>
                <Separator />
                <MenuItem Click="ShowScriptEditor_OnClick" Header="_Show Script Editor">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/javascript-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="Options_OnClick" Header="_Options…">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/settings-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="HelpMenuItem" Header="_Help">
                <MenuItem
                    Click="UserGuide_OnClick"
                    Header="_User Guide"
                    InputGestureText="F1">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/question-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Click="About_OnClick" Header="_About BBS Navigator">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="pack://application:,,,/BbsNavigator;component/Assets/app.png" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border
            x:Name="WorkspaceBorder"
            Grid.Row="2"
            Margin="4,0,4,4"
            BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
            BorderThickness="1,0,1,1">
            <ad:DockingManager
                x:Name="DockingManager"
                ActiveContentChanged="DockingManager_OnActiveContentChanged"
                DocumentClosed="DockingManager_OnDocumentClosed">
                <ad:DockingManager.Theme>
                    <ad:MosaicTheme />
                </ad:DockingManager.Theme>
                <ad:LayoutRoot>
                    <ad:LayoutPanel Orientation="Horizontal">
                        <ad:LayoutAnchorablePane DockMinWidth="230" DockWidth="315">
                            <ad:LayoutAnchorable
                                x:Name="BbsDirectoryAnchorable"
                                Title="BBS Directory"
                                CanAutoHide="True"
                                CanClose="False"
                                CanFloat="False"
                                CanHide="False"
                                ContentId="bbs-directory">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Padding="2"
                                        Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}"
                                        BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
                                        BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <ToolBar>
                                                <Button Margin="2,0,0,0" Click="AddBbs_OnClick">
                                                    <mosaic:SimpleStackPanel Orientation="Horizontal">
                                                        <Image
                                                            Width="18"
                                                            Height="18"
                                                            Source="pack://application:,,,/BbsNavigator;component/Assets/add-48.png" />
                                                        <TextBlock Margin="4,0,0,0" Text="Add" />
                                                    </mosaic:SimpleStackPanel>
                                                </Button>

                                                <Button Margin="2,0,0,0" Click="EditBbs_OnClick">
                                                    <mosaic:SimpleStackPanel Orientation="Horizontal">
                                                        <Image
                                                            Width="18"
                                                            Height="18"
                                                            Source="pack://application:,,,/BbsNavigator;component/Assets/edit-property-48.png" />
                                                        <TextBlock Margin="4,0,0,0" Text="Edit" />
                                                    </mosaic:SimpleStackPanel>
                                                </Button>

                                                <Button Margin="2,0,0,0" Click="RemoveBbs_OnClick">
                                                    <mosaic:SimpleStackPanel Orientation="Horizontal">
                                                        <Image
                                                            Width="18"
                                                            Height="18"
                                                            Source="pack://application:,,,/BbsNavigator;component/Assets/minus-48.png" />
                                                        <TextBlock Margin="4,0,0,0" Text="Remove" />
                                                    </mosaic:SimpleStackPanel>
                                                </Button>

                                                <Button
                                                    x:Name="SortBbsButton"
                                                    Margin="2,0,0,0"
                                                    Click="SortBbs_OnClick">
                                                    <mosaic:SimpleStackPanel Orientation="Horizontal">
                                                        <Image
                                                            Width="18"
                                                            Height="18"
                                                            Source="pack://application:,,,/BbsNavigator;component/Assets/sort-48.png" />
                                                        <TextBlock Margin="4,0,0,0" Text="Sort" />
                                                    </mosaic:SimpleStackPanel>
                                                </Button>
                                            </ToolBar>
                                        </DockPanel>
                                    </Border>

                                    <mosaic:SearchBox
                                        Grid.Row="1"
                                        Margin="8"
                                        Watermark="Search saved systems…">
                                        <i:Interaction.Behaviors>
                                            <mosaic:ItemsControlFilterBehavior TargetItemsControl="{Binding ElementName=BbsTree}" />
                                        </i:Interaction.Behaviors>
                                    </mosaic:SearchBox>

                                    <TreeView
                                        x:Name="BbsTree"
                                        Grid.Row="2"
                                        dd:DragDrop.DropHandler="{x:Static common:BbsDirectoryDropHandler.Instance}"
                                        dd:DragDrop.IsDragSource="True"
                                        dd:DragDrop.IsDropTarget="True"
                                        BorderThickness="0"
                                        ItemsSource="{Binding BbsProfiles}"
                                        MouseDoubleClick="BbsTree_OnMouseDoubleClick"
                                        ScrollViewer.CanContentScroll="True"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                        <TreeView.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:BbsProfile}">
                                                <Border
                                                    Padding="8,7"
                                                    Background="Transparent"
                                                    CornerRadius="3">
                                                    <Border.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem
                                                                Click="ConnectBbs_OnClick"
                                                                Header="_Connect"
                                                                IsEnabled="{Binding CanConnectTelnet}" />
                                                            <MenuItem
                                                                Click="ConnectBbsSsh_OnClick"
                                                                Header="Connect with _SSH"
                                                                IsEnabled="{Binding CanConnectSsh}" />
                                                            <Separator />
                                                            <MenuItem Click="EditBbsDetails_OnClick" Header="_Edit BBS Details…" />
                                                            <MenuItem Click="EditAliases_OnClick" Header="Edit _Aliases…" />
                                                            <Separator />
                                                            <MenuItem Click="ToggleFavorite_OnClick" Header="_Toggle Favorite" />
                                                            <Separator />
                                                            <MenuItem Click="EditCredentials_OnClick" Header="_Edit Credentials…" />
                                                            <MenuItem
                                                                Click="ViewCredentials_OnClick"
                                                                Header="_View Credentials…"
                                                                IsEnabled="{Binding EncryptedCredentials, Converter={x:Static converters:HasCredentialsConverter.Instance}}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding LastConnected, Converter={x:Static converters:LastConnectedConverter.Instance}}" />
                                                                <TextBlock Text="{Binding ConnectionCount, StringFormat='Successful Connections: {0:N0}'}" />
                                                            </StackPanel>
                                                        </Grid.ToolTip>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Image
                                                            x:Name="ConnectionIcon"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Source="Assets/terminal-gray-48.png" />
                                                        <mosaic:FavoriteCheckBox
                                                            Grid.Row="1"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="0,2,8,0"
                                                            HorizontalAlignment="Left"
                                                            IsChecked="{Binding Favorite, Mode=TwoWay}"
                                                            Symbol="&#x2605;"
                                                            SymbolSize="14"
                                                            ToolTip="Favorite" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <mosaic:Shield
                                                            x:Name="EndpointShield"
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="0,2,0,0"
                                                            Label="{Binding Host}"
                                                            ValueBackgroundBrush="Green"
                                                            ValueForegroundBrush="White"
                                                            Value="{Binding DirectoryPort}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!--  A board reachable over both transports is called out on its shield.  -->
                                                    <DataTrigger Binding="{Binding CanConnectTelnetAndSsh}" Value="True">
                                                        <Setter TargetName="EndpointShield" Property="ValueBackgroundBrush" Value="#FF1F5FA8" />
                                                        <Setter TargetName="EndpointShield" Property="ValueForegroundBrush" Value="White" />
                                                        <Setter TargetName="EndpointShield" Property="ToolTip" Value="Telnet and SSH" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:BbsConnectionState.Connected}">
                                                        <Setter TargetName="ConnectionIcon" Property="Source" Value="Assets/terminal-48.png" />
                                                    </DataTrigger>
                                                    <!--  Placeholder until a dedicated connecting icon is available.  -->
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static models:BbsConnectionState.Connecting}">
                                                        <Setter TargetName="ConnectionIcon" Property="Source" Value="Assets/terminal-gray-48.png" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="10,7"
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="Double-click a system to connect" />
                                </Grid>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>

                        <ad:LayoutDocumentPane>
                            <ad:LayoutDocument
                                x:Name="InitialUserGuideDocument"
                                Title="User Guide"
                                CanClose="True"
                                ContentId="user-guide"
                                IsSelected="True">
                                <views:UserGuideView />
                            </ad:LayoutDocument>
                        </ad:LayoutDocumentPane>
                        <ad:LayoutAnchorablePane DockMinWidth="300" DockWidth="420">
                            <ad:LayoutAnchorable
                                x:Name="SettingsAnchorable"
                                Title="Settings"
                                AutoHideWidth="420"
                                CanClose="False"
                                CanHide="True"
                                ContentId="settings">
                                <mosaic:PropertyGrid Margin="8" Object="{Binding}" />
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutPanel>
                </ad:LayoutRoot>
            </ad:DockingManager>
        </Border>

        <!--  Full screen hides the title bar and menu, so this is the only way back out with the mouse.  -->
        <Button
            x:Name="ExitFullScreenButton"
            Grid.Row="2"
            Margin="0,6,18,0"
            Padding="10,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="ToggleFullScreen_OnClick"
            Opacity="0.45"
            ToolTip="Leave full screen (Alt+Enter)"
            Visibility="Collapsed">
            <Button.Style>
                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,1,6,0"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Text="&#xE73F;" />
                <TextBlock FontSize="11" Text="Exit Full Screen" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
