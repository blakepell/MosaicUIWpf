<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.RibbonWindowExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel MaxWidth="640" Margin="24">
        <TextBlock
            FontSize="22"
            FontWeight="Light"
            Text="Ribbon in its own window" />
        <TextBlock
            Margin="0,12,0,0"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
            TextWrapping="Wrap">
            Opens Mosaic Writer, a small word processor that hosts the Ribbon the way an application would: a custom title bar, the Ribbon with its Backstage and Quick Access Toolbar, a document, and a status bar. Resize the window to watch the Ribbon adapt. File commands (Open, Save, Save As, Print) work on Rich Text files, and the Ribbon's preferences are saved when the window closes. The source shown for this example is the window itself.
        </TextBlock>
        <Button
            Margin="0,20,0,0"
            Padding="18,8"
            HorizontalAlignment="Left"
            Click="OpenWindow_Click"
            Content="Open Mosaic Writer" />
    </StackPanel>
</UserControl>
