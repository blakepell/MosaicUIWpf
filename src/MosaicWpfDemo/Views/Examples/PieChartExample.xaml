<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.PieChartExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MosaicWpfDemo.Views.Examples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Orientation="Vertical">

            <TextBlock
                Margin="0,0,0,10"
                Text="The chart is bound to an ObservableCollection of PieCategory. Each slice is sized by its Value relative to the total of every value, so the values are raw numbers rather than percentages. Adding, removing, or editing a category repaints the chart automatically."
                TextWrapping="Wrap" />

            <!--  The chart binds straight to the collection on the code behind, no refresh call needed.  -->
            <Border
                Height="380"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1"
                CornerRadius="4">
                <controls:PieChart
                    x:Name="Chart"
                    Categories="{Binding Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="14"
                    LegendPosition="Right"
                    SliceClicked="Chart_SliceClicked" />
            </Border>

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <controls:AccentButton Click="RandomizeValues_Click" Content="Randomize Values" />
                <controls:AccentButton
                    Margin="5,0,0,0"
                    AccentButtonType="Gray"
                    Click="AddCategory_Click"
                    Content="Add Slice" />
                <controls:AccentButton
                    Margin="5,0,0,0"
                    AccentButtonType="FluentRed"
                    Click="RemoveCategory_Click"
                    Content="Remove Slice" />
            </StackPanel>

            <!--  Clicking a slice raises SliceClicked with the PieCategory on the event args.  -->
            <TextBlock
                x:Name="ClickResult"
                Margin="0,10,0,0"
                Text="Click a slice to see the SliceClicked event fire."
                TextWrapping="Wrap" />

            <!--  A second chart showing explicit slice colors and the legend along the bottom.  -->
            <TextBlock
                Margin="0,20,0,10"
                Text="Each PieCategory can carry its own ColorBrush. Categories that leave it null are painted with a color from the chart's palette. The legend can be placed on any side with LegendPosition."
                TextWrapping="Wrap" />

            <Border
                Height="360"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1"
                CornerRadius="4">
                <controls:PieChart
                    x:Name="StatusChart"
                    Categories="{Binding StatusCategories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="14"
                    LegendPosition="Bottom"
                    StrokeThickness="3" />
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
