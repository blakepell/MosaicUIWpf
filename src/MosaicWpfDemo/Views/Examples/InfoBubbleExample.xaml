<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.InfoBubbleExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Padding="12"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock
            Margin="0,0,0,8"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Notification indicators" />
        <TextBlock
            Margin="0,0,0,24"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
            Text="InfoBubble overlays counts, capped values, status dots, or custom content on any element."
            TextWrapping="Wrap" />

        <WrapPanel>
            <controls:InfoBubble
                Margin="0,0,28,28"
                InfoBubbleContent="7"
                InfoBubbleMargin="-8">
                <Border
                    Width="150"
                    Height="80"
                    Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Inbox" />
                </Border>
            </controls:InfoBubble>

            <controls:InfoBubble
                Margin="0,0,28,28"
                InfoBubbleBackground="{DynamicResource {x:Static themes:MosaicTheme.ErrorBrush}}"
                InfoBubbleContent="128"
                InfoBubbleMargin="-8"
                InfoBubbleMaxValue="99">
                <Border
                    Width="150"
                    Height="80"
                    Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Capped at 99+" />
                </Border>
            </controls:InfoBubble>

            <controls:InfoBubble
                Margin="0,0,28,28"
                HideWhenZero="True"
                InfoBubbleContent="0"
                InfoBubbleMargin="-8">
                <Border
                    Width="150"
                    Height="80"
                    Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Zero is hidden" />
                </Border>
            </controls:InfoBubble>

            <controls:InfoBubble
                Margin="0,0,28,28"
                InfoBubbleBackground="{DynamicResource {x:Static themes:MosaicTheme.SuccessBrush}}"
                InfoBubbleMargin="-5"
                InfoBubblePlacementMode="BottomLeft"
                IsDot="True">
                <Border
                    Width="150"
                    Height="80"
                    Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Bottom-left status dot" />
                </Border>
            </controls:InfoBubble>

            <controls:InfoBubble
                Margin="0,0,28,0"
                InfoBubbleBackground="{DynamicResource {x:Static themes:MosaicTheme.SuccessBrush}}"
                InfoBubbleContent="25"
                InfoBubbleFontSize="12"
                InfoBubbleMargin="-5"
                InfoBubblePlacementMode="BottomLeft"
                IsDot="False">
                <Border
                    Width="150"
                    Height="80"
                    Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Bottom-left status dot" />
                </Border>
            </controls:InfoBubble>

            <controls:InfoBubble
                Margin="0,0,0,0"
                InfoBubbleBackground="{DynamicResource {x:Static themes:MosaicTheme.ErrorBrush}}"
                InfoBubbleContent="!"
                InfoBubbleFontWeight="Bold"
                InfoBubbleMargin="-5"
                InfoBubblePlacementMode="BottomLeft"
                IsDot="False">
                <Border
                    Width="150"
                    Height="80"
                    Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightBrush}}"
                    BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="Bottom-left status dot" />
                </Border>
            </controls:InfoBubble>


        </WrapPanel>
    </StackPanel>
</UserControl>
