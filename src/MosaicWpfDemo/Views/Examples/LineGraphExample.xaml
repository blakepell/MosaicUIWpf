<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.LineGraphExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MosaicWpfDemo.Views.Examples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Orientation="Vertical">

            <TextBlock
                Margin="0,0,0,10"
                Text="The graph is bound to an ObservableCollection of LineGraphSeries. Each series has its own caption, colour and set of time stamped points. Adding, removing or editing a series or a point repaints the graph automatically, and the colours follow the current Mosaic theme."
                TextWrapping="Wrap" />

            <!--  Three series over a month of daily readings. The time unit is chosen automatically from the span.  -->
            <Border
                Height="380"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1"
                CornerRadius="4">
                <controls:LineGraph
                    x:Name="Graph"
                    PointClicked="Graph_PointClicked"
                    Series="{Binding DailySeries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    SeriesClicked="Graph_SeriesClicked"
                    Title="Daily Active Users by Region" />
            </Border>

            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <controls:AccentButton Click="RandomizeValues_Click" Content="Randomize Values" />
                <controls:AccentButton
                    Margin="5,0,0,0"
                    AccentButtonType="Gray"
                    Click="AddDay_Click"
                    Content="Add Day" />
                <controls:AccentButton
                    Margin="5,0,0,0"
                    AccentButtonType="Gray"
                    Click="AddSeries_Click"
                    Content="Add Series" />
                <controls:AccentButton
                    Margin="5,0,0,0"
                    AccentButtonType="FluentRed"
                    Click="RemoveSeries_Click"
                    Content="Remove Series" />
                <controls:AccentButton
                    Margin="5,0,0,0"
                    AccentButtonType="Gray"
                    Click="ToggleTitle_Click"
                    Content="Toggle Title" />
            </StackPanel>

            <!--  Clicking a line raises SeriesClicked; clicking a point raises PointClicked with the point and its series.  -->
            <TextBlock
                x:Name="ClickResult"
                Margin="0,10,0,0"
                Text="Click a line, a point, or a legend entry to see the SeriesClicked and PointClicked events fire."
                TextWrapping="Wrap" />

            <!--  A second graph with an explicit time unit, fixed bounds and no title, so the plot takes the full height.  -->
            <TextBlock
                Margin="0,20,0,10"
                Text="TimeUnit can be pinned (here to Hours), the Y-axis can be given fixed MinimumValue / MaximumValue bounds, and a series can carry its own Brush and LineThickness. With no Title the plot reclaims the title row."
                TextWrapping="Wrap" />

            <Border
                Height="300"
                BorderBrush="{DynamicResource {x:Static theme:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1"
                CornerRadius="4">
                <controls:LineGraph
                    x:Name="HourlyGraph"
                    IntervalCount="4"
                    MaximumValue="100"
                    MinimumValue="0"
                    PointRadius="3"
                    Series="{Binding HourlySeries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    TimeUnit="Hours"
                    ValueLabelFormat="0'%'" />
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
