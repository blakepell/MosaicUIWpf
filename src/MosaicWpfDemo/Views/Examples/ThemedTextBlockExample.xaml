<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.ThemedTextBlockExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:themes="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="650"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                Text="ThemedTextBlock finds the nearest Border, Panel, Control, or TextBlock background and selects a foreground automatically. PaletteFamily and PaletteShade apply Mosaic's family-specific switch points."
                TextWrapping="Wrap" />

            <TextBlock
                Margin="0,6,0,16"
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                Text="The default luminance threshold is 0.21. Set LuminanceThreshold higher when the design should favor white text on lighter colors."
                TextWrapping="Wrap" />

            <UniformGrid Columns="3">
                <Border
                    Margin="4"
                    Padding="20"
                    Background="{DynamicResource {x:Static themes:AssetResourceKeys.Blue500BackgroundBrushKey}}"
                    CornerRadius="4">
                    <mosaic:ThemedTextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Blue 500 · automatic" />
                </Border>

                <Border
                    Margin="4"
                    Padding="20"
                    Background="{DynamicResource {x:Static themes:AssetResourceKeys.Yellow500BackgroundBrushKey}}"
                    CornerRadius="4">
                    <mosaic:ThemedTextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        PaletteFamily="Yellow"
                        PaletteShade="500"
                        Text="Yellow 500 · palette-aware" />
                </Border>

                <Border
                    Margin="4"
                    Padding="20"
                    Background="{DynamicResource {x:Static themes:AssetResourceKeys.Blue200BackgroundBrushKey}}"
                    CornerRadius="4">
                    <mosaic:ThemedTextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Blue 200 · automatic" />
                </Border>
            </UniformGrid>

            <TextBlock
                Margin="0,24,0,4"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                Text="Adjust the white switch point" />

            <Grid Margin="4,4,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    x:Name="ThresholdSlider"
                    Minimum="0.1"
                    Maximum="0.4"
                    SmallChange="0.01"
                    TickFrequency="0.01"
                    Value="0.21" />
                <TextBlock
                    Grid.Column="1"
                    MinWidth="70"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                    Text="{Binding Value, ElementName=ThresholdSlider, StringFormat={}{0:F2}}" />
            </Grid>

            <UniformGrid Columns="2">
                <Border
                    Margin="4"
                    Padding="24"
                    Background="{DynamicResource {x:Static themes:AssetResourceKeys.Blue400BackgroundBrushKey}}"
                    CornerRadius="4">
                    <mosaic:ThemedTextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        LuminanceThreshold="{Binding Value, ElementName=ThresholdSlider}"
                        Text="Blue 400" />
                </Border>

                <Border
                    Margin="4"
                    Padding="24"
                    Background="{DynamicResource {x:Static themes:AssetResourceKeys.Yellow600BackgroundBrushKey}}"
                    CornerRadius="4">
                    <mosaic:ThemedTextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        LuminanceThreshold="{Binding Value, ElementName=ThresholdSlider}"
                        Text="Yellow 600" />
                </Border>
            </UniformGrid>

            <TextBlock
                Margin="0,20,0,8"
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                Text="You can also pair a brush explicitly when ancestor detection is not appropriate:"
                TextWrapping="Wrap" />

            <mosaic:ThemedTextBlock
                BackgroundBrush="{DynamicResource {x:Static themes:AssetResourceKeys.Indigo500BackgroundBrushKey}}"
                FontFamily="{DynamicResource {x:Static themes:MosaicTheme.MonospaceFontFamily}}"
                Text="&lt;mosaic:ThemedTextBlock BackgroundBrush=&quot;{DynamicResource ...}&quot; /&gt;" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
