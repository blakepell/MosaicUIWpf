<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.IPv4TextBoxExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="650"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="IPv4 address entry" />
            <TextBlock
                Margin="0,4,0,16"
                Text="Each editor looks like one text box while providing four independently validated numeric segments. Type a period or complete three digits to advance."
                TextWrapping="Wrap" />

            <Border
                Padding="16"
                Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Two-way binding and rejected assignments" />
                    <TextBlock
                        Margin="0,4,0,12"
                        Text="The view-model property changes only after all four segments form a valid address. An invalid external assignment leaves the control unchanged."
                        TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Bound address" />
                        <mosaic:IPv4TextBox
                            x:Name="BoundAddress"
                            Grid.Column="1"
                            Text="{Binding IpAddress, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,6,0,0"
                            Text="{Binding IpAddress, StringFormat=View-model value: {0}}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                            <Button Click="AssignValidAddress_Click" Content="Assign 10.20.30.40" />
                            <Button Margin="8,0,0,0" Click="AssignInvalidAddress_Click" Content="Try 256.1.1.1" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding AssignmentResult}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Margin="0,16,0,0"
                Padding="16"
                Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Margin="0,0,0,12" FontWeight="SemiBold" Text="Appearance and state examples" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Leading zeros" />
                    <mosaic:IPv4TextBox Grid.Row="1" Grid.Column="1" Text="192.168.001.010" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Text="Formatting is preserved." />

                    <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center" Text="Empty" />
                    <mosaic:IPv4TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,10,0,0" VerticalAlignment="Center" Text="Tab or click to focus the first segment." />

                    <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Center" Text="Customized" />
                    <mosaic:IPv4TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Padding="12,5"
                        BorderThickness="2"
                        FontSize="16"
                        Text="127.0.0.1" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="12,10,0,0" VerticalAlignment="Center" Text="Standard control properties flow into the template." />

                    <TextBlock Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Center" Text="Disabled" />
                    <mosaic:IPv4TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        IsEnabled="False"
                        Text="255.255.255.255" />
                </Grid>
            </Border>

            <TextBlock
                Margin="0,16,0,0"
                Text="Paste a complete address such as 172.16.0.25 into any segment. Invalid or partial clipboard content is ignored transactionally."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
