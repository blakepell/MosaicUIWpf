<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.TrayIconExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MosaicWpfDemo.Views.Examples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Declaring the tray icon as a resource creates no shell state; it appears when IsVisible becomes true.  -->
        <controls:TrayIcon
            x:Key="DemoTray"
            DoubleClickCommand="{Binding RestoreWindowCommand}"
            Icon="/Assets/collage-48.png"
            IsVisible="{Binding IsTrayVisible}"
            ToolTipText="{Binding ToolTipText}">
            <ContextMenu>
                <MenuItem Command="{Binding RestoreWindowCommand}" Header="_Open Mosaic Demo">
                    <MenuItem.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="/Assets/home-48.png" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding MinimizeWindowCommand}" Header="_Minimize Window" />
                <Separator />
                <MenuItem Header="_Icon">
                    <MenuItem Command="{Binding SetIconCommand}" CommandParameter="collage" Header="Collage (PNG)" />
                    <MenuItem Command="{Binding SetIconCommand}" CommandParameter="shield" Header="Shield (PNG)" />
                    <MenuItem Command="{Binding SetIconCommand}" CommandParameter="vector" Header="Vector (DrawingImage)" />
                </MenuItem>
                <MenuItem
                    Header="_Log Mouse Hover"
                    IsCheckable="True"
                    IsChecked="{Binding LogHover}" />
                <MenuItem Header="Disabled Item" IsEnabled="False" />
                <Separator />
                <MenuItem Command="{Binding HideTrayCommand}" Header="_Hide Tray Icon" />
            </ContextMenu>
        </controls:TrayIcon>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                Text="Mosaic.UI.Wpf.Controls.TrayIcon shows an icon in the Windows notification area with a genuine WPF ContextMenu." />
            <TextBlock
                Margin="0,0,0,12"
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                Text="Show the icon, then right-click it (or focus it with Win+B and press Shift+F10). Double-click restores this window. Try restarting Explorer while it is visible."
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <CheckBox
                VerticalAlignment="Center"
                Content="Show tray icon"
                IsChecked="{Binding IsTrayVisible}" />
            <TextBlock
                Margin="24,0,6,0"
                VerticalAlignment="Center"
                Text="Tooltip:" />
            <TextBox Width="240" Text="{Binding ToolTipText, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="12,0,0,0"
                Padding="10,2"
                Command="{Binding ClearLogCommand}"
                Content="Clear Log" />
        </StackPanel>

        <ListBox
            Grid.Row="2"
            FontFamily="Consolas"
            ItemsSource="{Binding Log}" />
    </Grid>
</UserControl>
