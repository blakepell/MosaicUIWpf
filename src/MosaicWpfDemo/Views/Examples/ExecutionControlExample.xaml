<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.ExecutionControlExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:themes="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  On a tool bar, driven entirely by commands and their CanExecute logic.  -->
        <ToolBar Grid.Row="0">
            <mosaic:ExecutionControl
                PauseCommand="{Binding PauseCommand}"
                PlayCommand="{Binding PlayCommand}"
                StopCommand="{Binding StopCommand}" />
        </ToolBar>

        <TextBlock Grid.Row="1" Margin="0,10,0,0">
            <Run Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" Text="State =" />
            <Run Foreground="CornflowerBlue" Text="{Binding RunState, Mode=OneWay}" />
        </TextBlock>

        <TextBlock
            Grid.Row="1"
            Margin="0,26,0,0"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
            Text="Stopped: only Play is available. Running: Play is muted while Pause and Stop are available. Paused: Play and Stop are available."
            TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Margin="0,0,0,6" Text="Larger icons, no pause button" />
            <mosaic:ExecutionControl
                HorizontalAlignment="Left"
                IconSize="24"
                PlayCommand="{Binding PlayCommand}"
                ShowPauseButton="False"
                StopCommand="{Binding StopCommand}" />

            <TextBlock Margin="0,16,0,6" Text="Vertical orientation with custom brushes and routed event logging" />
            <mosaic:ExecutionControl
                HorizontalAlignment="Left"
                Orientation="Vertical"
                PauseClick="ExecutionControl_OnPauseClick"
                PauseCommand="{Binding PauseCommand}"
                PlayBrush="{DynamicResource {x:Static themes:MosaicTheme.AccentBrush}}"
                PlayClick="ExecutionControl_OnPlayClick"
                PlayCommand="{Binding PlayCommand}"
                StopClick="ExecutionControl_OnStopClick"
                StopCommand="{Binding StopCommand}" />
        </StackPanel>

        <ListBox
            Grid.Row="3"
            Margin="0,20,0,0"
            ItemsSource="{Binding ActivityLog}" />
    </Grid>
</UserControl>
