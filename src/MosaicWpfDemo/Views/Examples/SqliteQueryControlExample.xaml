<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.SqliteQueryControlExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MosaicWpfDemo.Views.Examples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
            TextWrapping="Wrap"
            Text="A scratch database is created in your temp folder when this page loads. Expand the tree, right-click a table for the context menu (the last item is added by this example through the SchemaContextMenuRequested event), and press F5 or the play button to run the editor's contents. Ctrl+Space requests auto-completion; typing FROM followed by a space, or a dot after a table name or alias, triggers it automatically." />

        <mosaic:SqliteQueryControl x:Name="QueryControl" Grid.Row="1" SchemaContextMenuRequested="OnSchemaContextMenuRequested" />
    </Grid>
</UserControl>
