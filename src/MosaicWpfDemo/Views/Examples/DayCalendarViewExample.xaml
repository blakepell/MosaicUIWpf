<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.DayCalendarViewExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:themes="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="650"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock
                FontSize="{DynamicResource {x:Static themes:MosaicTheme.FontSizeLarge}}"
                FontWeight="SemiBold"
                Text="Outlook-style day calendar" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                Text="Click an event to run a command. Drag vertically to propose a new time; drops snap to 15 minutes. Press Escape to cancel a drag."
                TextWrapping="Wrap" />
        </StackPanel>

        <mosaic:DayCalendarView
            Grid.Row="1"
            AllowCrossDayEvents="False"
            BackgroundPath="Color"
            DescriptionPath="Location"
            DragSnapInterval="00:15:00"
            EndDatePath="Finish"
            EventCommand="{Binding OpenEventCommand}"
            EventTimeChangedCommand="{Binding ChangeEventTimeCommand}"
            HourHeight="80"
            InitialScrollTime="07:30:00"
            ItemsSource="{Binding Events}"
            IsReadOnlyPath="IsReadOnly"
            SelectedDate="{Binding SelectedDate}"
            SelectedItem="{Binding SelectedEvent}"
            StartDatePath="Begin"
            TitlePath="Subject" />

        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="8"
            Background="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBackgroundBrush}}"
            BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
