<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.ColorPaletteExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:themes="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="900"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="PaletteSwatchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="SwatchBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Border
                                x:Name="InteractionOverlay"
                                Background="#1FFFFFFF"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionOverlay" Property="Background" Value="#26000000" />
                                <Setter TargetName="InteractionOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
            Text="Each 500 swatch is the supplied base color. Select a tile or right-click it to copy its XAML DynamicResource expression."
            TextWrapping="Wrap" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Palettes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <mosaic:ContentPanel
                            Title="{Binding DisplayName}"
                            Margin="0,0,0,12"
                            Background="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            HeaderBackground="{Binding HeaderBrush}"
                            HeaderForeground="{Binding HeaderForegroundBrush}"
                            SeparatorVisibility="Collapsed">
                            <ItemsControl ItemsSource="{Binding Swatches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="9" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Height="92"
                                            MinWidth="100"
                                            AutomationProperties.HelpText="Copies the XAML DynamicResource expression."
                                            AutomationProperties.Name="{Binding ShortName, StringFormat={}{0} color swatch}"
                                            Background="{Binding Brush}"
                                            Click="CopyDynamicResource_OnClick"
                                            Foreground="{Binding ForegroundBrush}"
                                            Style="{StaticResource PaletteSwatchButtonStyle}"
                                            ToolTip="{Binding ResourceExpression}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem
                                                        Click="CopyDynamicResource_OnClick"
                                                        Header="Copy XAML DynamicResource"
                                                        InputGestureText="Enter" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding ShortName}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontFamily="{DynamicResource {x:Static themes:MosaicTheme.MonospaceFontFamily}}"
                                                    Text="{Binding Hex}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </mosaic:ContentPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock
            x:Name="CopyStatusText"
            Grid.Row="2"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
            Text="No resource expression copied yet."
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>

