<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.HorizontalListBoxExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="10" Orientation="Vertical">

        <!--  Days of the week with a label beside it, weekdays pre-selected.  -->
        <TextBlock
            Margin="0,0,0,6"
            FontWeight="SemiBold"
            Text="Days of the Week" />
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Text="Repeat on" />
            <mosaic:HorizontalListBox
                x:Name="DayList"
                VerticalAlignment="Center"
                DisplayMemberPath="Abbreviation"
                ItemsSource="{Binding Days}"
                SelectionChanged="HorizontalListBox_OnSelectionChanged" />
        </StackPanel>
        <TextBlock Margin="0,8,0,20" TextWrapping="Wrap">
            <Run Text="Selected days: " />
            <Run Foreground="CornflowerBlue" Text="{Binding SelectedDaySummary}" />
        </TextBlock>

        <!--  Single selection behaves like a segmented picker.  -->
        <TextBlock
            Margin="0,0,0,6"
            FontWeight="SemiBold"
            Text="Single Selection (Segmented)" />
        <mosaic:HorizontalListBox
            x:Name="ViewList"
            ItemCornerRadius="0"
            ItemMinWidth="72"
            ItemSpacing="0"
            ItemsSource="{Binding Views}"
            SelectionChanged="HorizontalListBox_OnSelectionChanged"
            SelectionMode="Single" />
        <TextBlock Margin="0,8,0,20" TextWrapping="Wrap">
            <Run Text="Active view: " />
            <Run Foreground="CornflowerBlue" Text="{Binding SelectedViewSummary}" />
        </TextBlock>

        <!--  Custom selected brush and pill shaped cells.  -->
        <TextBlock
            Margin="0,0,0,6"
            FontWeight="SemiBold"
            Text="Custom Brush and Pill Cells" />
        <mosaic:HorizontalListBox
            x:Name="PriorityList"
            ItemCornerRadius="14"
            ItemMinWidth="0"
            ItemPadding="14,5"
            ItemSpacing="8"
            ItemsSource="{Binding Priorities}"
            SelectedBackground="{DynamicResource {x:Static themes:MosaicTheme.SuccessBrush}}"
            SelectionChanged="HorizontalListBox_OnSelectionChanged" />
        <TextBlock Margin="0,8,0,20" TextWrapping="Wrap">
            <Run Text="Selected priorities: " />
            <Run Foreground="CornflowerBlue" Text="{Binding SelectedPrioritySummary}" />
        </TextBlock>

        <!--  Custom ItemTemplate.  -->
        <TextBlock
            Margin="0,0,0,6"
            FontWeight="SemiBold"
            Text="Custom ItemTemplate" />
        <mosaic:HorizontalListBox
            x:Name="ChannelList"
            ItemMinWidth="88"
            ItemsSource="{Binding Channels}"
            SelectionChanged="HorizontalListBox_OnSelectionChanged">
            <mosaic:HorizontalListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Text="{Binding Glyph}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Text="{Binding Name}" />
                    </StackPanel>
                </DataTemplate>
            </mosaic:HorizontalListBox.ItemTemplate>
        </mosaic:HorizontalListBox>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
            <Run Text="Selected channels: " />
            <Run Foreground="CornflowerBlue" Text="{Binding SelectedChannelSummary}" />
        </TextBlock>
    </StackPanel>
</UserControl>
