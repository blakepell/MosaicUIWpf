<UserControl
    x:Class="MosaicWpfDemo.Views.Examples.VisualCaptureExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Mosaic.UI.Wpf.Behaviors;assembly=Mosaic.UI.Wpf"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls;assembly=Mosaic.UI.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:MosaicWpfDemo.Views.Examples"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes;assembly=Mosaic.UI.Wpf"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="10">
        <TextBlock
            Margin="0,0,0,4"
            FontWeight="SemiBold"
            Text="VisualCapture renders any UIElement to an image and copies it to the clipboard or saves it to a file." />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
            Text="If the element scrolls, the whole horizontal and vertical scroll extent is captured, not just the visible viewport.  Use VisualCapture directly from code, drop in a VisualCaptureButton, or attach VisualCaptureContextMenuBehavior to add Copy/Save as Image items to a right-click menu."
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,8,0,6"
            FontWeight="SemiBold"
            Text="VisualCaptureButton targeting a scrolling ListBox (only the first few rows are visible, all 40 are captured)" />
        <StackPanel Orientation="Horizontal">
            <ListBox
                x:Name="CaptureListBox"
                Width="320"
                Height="140"
                HorizontalAlignment="Left"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Top">
                <controls:VisualCaptureButton
                    Width="140"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Left"
                    CaptureBackground="{DynamicResource {x:Static themes:MosaicTheme.WindowBackgroundBrush}}"
                    Captured="OnCaptured"
                    CaptureFailed="OnCaptureFailed"
                    Mode="CopyToClipboard"
                    TargetName="CaptureListBox" />
                <controls:VisualCaptureButton
                    Width="140"
                    HorizontalAlignment="Left"
                    CaptureBackground="{DynamicResource {x:Static themes:MosaicTheme.WindowBackgroundBrush}}"
                    Captured="OnCaptured"
                    CaptureFailed="OnCaptureFailed"
                    DefaultFileName="list-box.png"
                    Mode="SaveToFile"
                    Target="{Binding ElementName=CaptureListBox}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Margin="0,16,0,6"
            FontWeight="SemiBold"
            Text="VisualCaptureContextMenuBehavior: right-click the panel below" />
        <Border
            x:Name="CapturePanel"
            Width="460"
            Padding="12"
            HorizontalAlignment="Left"
            Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}"
            BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
            BorderThickness="1"
            CornerRadius="6">
            <i:Interaction.Behaviors>
                <behaviors:VisualCaptureContextMenuBehavior CaptureBackground="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}" Captured="OnCaptured" CaptureFailed="OnCaptureFailed" DefaultFileName="panel.png" />
            </i:Interaction.Behaviors>
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Quarterly Summary" />
                <TextBlock Margin="0,4,0,0" Text="This panel has no context menu of its own, so the behavior creates one containing Copy as Image and Save as Image." TextWrapping="Wrap" />
                <controls:RadialProgressBar
                    Width="80"
                    Height="80"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Value="72" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,16,0,6"
            FontWeight="SemiBold"
            Text="Appending to an existing context menu" />
        <TextBox
            x:Name="CaptureTextBox"
            Width="460"
            Height="80"
            HorizontalAlignment="Left"
            AcceptsReturn="True"
            Text="This text box declares its own Cut/Copy/Paste context menu; the behavior appends the image items after a separator."
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Cut" />
                    <MenuItem Command="ApplicationCommands.Copy" />
                    <MenuItem Command="ApplicationCommands.Paste" />
                </ContextMenu>
            </TextBox.ContextMenu>
            <i:Interaction.Behaviors>
                <behaviors:VisualCaptureContextMenuBehavior Captured="OnCaptured" CaptureFailed="OnCaptureFailed" />
            </i:Interaction.Behaviors>
        </TextBox>

        <TextBlock
            Margin="0,16,0,6"
            FontWeight="SemiBold"
            Text="Calling VisualCapture from code" />
        <controls:AccentButton
            Width="200"
            HorizontalAlignment="Left"
            Click="OnCopyWholePageClick"
            Content="Copy this whole page" />

        <TextBlock
            x:Name="StatusTextBlock"
            Margin="0,16,0,0"
            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
            Text="Nothing captured yet."
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
