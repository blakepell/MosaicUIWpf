<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <!--
        Black theme: true black window and text surfaces, with a neutral gray ramp for raised
        surfaces, borders, separators and hover states. Accent/selection colors match Dark.
    -->

    <!--  MOSAIC CUSTOM COLORS  -->
    <Color x:Key="{x:Static themes:MosaicTheme.AccentColor}">#FF0078D7</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.AccentBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.AccentColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.AccentHoverColor}">#FF1E87E0</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.AccentHoverBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.AccentHoverColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.FluentGreenColor}">#FF13A10E</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.FluentGreenBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.FluentGreenColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.FluentGreenHoverColor}">#FF22B01D</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.FluentGreenHoverBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.FluentGreenHoverColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.FluentRedColor}">#FFE74856</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.FluentRedBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.FluentRedColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.FluentRedHoverColor}">#FFF1707A</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.FluentRedHoverBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.FluentRedHoverColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.AccentBorderColor}">#FF005A9E</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.AccentBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.AccentBorderColor}}" />

    <!--  Selection  -->
    <Color x:Key="{x:Static themes:MosaicTheme.SelectionBackgroundColor}">#FF3399FF</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.SelectionBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.SelectionBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.SelectionForegroundColor}">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.SelectionForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.SelectionForegroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.InactiveSelectionBackgroundColor}">#FF333333</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.InactiveSelectionBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.InactiveSelectionBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.InactiveSelectionBorderColor}">#FF404040</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.InactiveSelectionBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.InactiveSelectionBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.PlaceholderTextColor}">#FF8A8A8A</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.PlaceholderTextBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.PlaceholderTextColor}}" />

    <!--  Status / Semantics  -->
    <Color x:Key="{x:Static themes:MosaicTheme.InfoColor}">#FF0078D7</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.InfoBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.InfoColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.SuccessColor}">#FF388A34</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.SuccessBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.SuccessColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.WarningColor}">#FFD18700</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.WarningBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.WarningColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ErrorColor}">#FFF44747</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ErrorBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ErrorColor}}" />

    <!--  Window  -->
    <Color x:Key="{x:Static themes:MosaicTheme.WindowBackgroundColor}">#FF000000</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.WindowBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.WindowBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.WindowForegroundColor}">#FFF1F1F1</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.WindowForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.WindowForegroundColor}}" />

    <!--  Control  -->
    <Color x:Key="{x:Static themes:MosaicTheme.ControlBackgroundColor}">#FF141414</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlBackgroundLightColor}">#FF1F1F1F</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlBackgroundLightBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundLightColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlForegroundColor}">#FFF1F1F1</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundColor}}" />

    <!--  MessageBox: header (top) is black, footer (buttons) slightly lifted  -->
    <Color x:Key="{x:Static themes:MosaicTheme.MessageBoxHeaderBackgroundColor}">#FF000000</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.MessageBoxHeaderBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.MessageBoxHeaderBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.MessageBoxFooterBackgroundColor}">#FF141414</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.MessageBoxFooterBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.MessageBoxFooterBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlBorderColor}">#FF3C3C3C</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlSelectedBorderColor}">#FF0078D7</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlSelectedBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlSelectedBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlHoverBackgroundColor}">#FF262626</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlHoverBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlHoverBorderColor}">#FF2196F3</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlHoverBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlTextBackgroundColor}">#FF000000</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlTextBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlTextBackgroundColor}}" />

    <!--  ListViewItem alternating rows  -->
    <Color x:Key="{x:Static themes:MosaicTheme.ListViewItemBackgroundColor}">#FF000000</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ListViewItemBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ListViewItemBackgroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.ListViewItemAlternateBackgroundColor}">#FF141414</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ListViewItemAlternateBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ListViewItemAlternateBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlTextForegroundColor}">#FFF1F1F1</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlTextForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlTextSecondaryForegroundColor}">#FFB4B4B4</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlPressedBackgroundColor}">#FF0078D7</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlPressedBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlPressedBorderColor}">#FF0078D7</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlPressedBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlDisabledBackgroundColor}">#FF1A1A1A</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlDisabledBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlDisabledForegroundColor}">#FF6A6A6A</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlDisabledForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledForegroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlDisabledBorderColor}">#FF2E2E2E</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlDisabledBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.ControlSeparatorColor}">#FF2A2A2A</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.SettingsItemSeparatorBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorColor}}" />
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.ControlSeparatorBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorColor}}" />

    <!--  Hyperlink  -->
    <Color x:Key="{x:Static themes:MosaicTheme.HyperLinkColor}">#FF569CD6</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.HyperLinkBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.HyperLinkColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.HyperLinkHoverColor}">#FF2A8DD4</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.HyperLinkHoverBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.HyperLinkHoverColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.HyperLinkVisitedColor}">#FFC8C8C8</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.HyperLinkVisitedBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.HyperLinkVisitedColor}}" />

    <!--  Tab & TabItem  -->
    <Color x:Key="{x:Static themes:MosaicTheme.TabItemSelectedBackgroundColor}">#FF000000</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TabItemSelectedBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TabItemSelectedBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.TabItemBackgroundColor}">#FF141414</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TabItemBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TabItemBackgroundColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.TabItemBorderColor}">#FF3C3C3C</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TabItemBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TabItemBorderColor}}" />

    <Color x:Key="{x:Static themes:MosaicTheme.TabItemForegroundColor}">#FFF1F1F1</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TabItemForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TabItemForegroundColor}}" />

    <!--  Document tabs  -->
    <Color x:Key="{x:Static themes:MosaicTheme.DocumentTabStripBackgroundColor}">#FF0A0A0A</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.DocumentTabStripBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.DocumentTabStripBackgroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.DocumentTabBackgroundColor}">#FF141414</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.DocumentTabBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.DocumentTabBackgroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.DocumentTabHoverBackgroundColor}">#FF262626</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.DocumentTabHoverBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.DocumentTabHoverBackgroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.DocumentTabSelectedBackgroundColor}">#FF000000</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.DocumentTabSelectedBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.DocumentTabSelectedBackgroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.DocumentTabBorderColor}">#FF3C3C3C</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.DocumentTabBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.DocumentTabBorderColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.DocumentTabForegroundColor}">#FFF1F1F1</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.DocumentTabForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.DocumentTabForegroundColor}}" />

    <!--  Sidebar  -->
    <Color x:Key="{x:Static themes:MosaicTheme.SidebarSelectedBackgroundColor}">#FF262626</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.SidebarSelectedBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.SidebarSelectedBackgroundColor}}" />

    <!--  Tag (TagBox) - Tailwind indigo-500 pill, same as Dark  -->
    <Color x:Key="{x:Static themes:MosaicTheme.TagBackgroundColor}">#FF6366F1</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TagBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TagBackgroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.TagForegroundColor}">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TagForegroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TagForegroundColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.TagBorderColor}">#FF818CF8</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TagBorderBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TagBorderColor}}" />
    <Color x:Key="{x:Static themes:MosaicTheme.TagDeleteHoverBackgroundColor}">#73312E81</Color>
    <SolidColorBrush x:Key="{x:Static themes:MosaicTheme.TagDeleteHoverBackgroundBrush}" Color="{DynamicResource {x:Static themes:MosaicTheme.TagDeleteHoverBackgroundColor}}" />

    <Thickness x:Key="{x:Static themes:MosaicTheme.ButtonBorderThickness}">0.8</Thickness>
    <CornerRadius x:Key="{x:Static themes:MosaicTheme.ButtonCornerRadius}">0</CornerRadius>

    <!--  DataGrid density. Override in a local resource scope for a tighter grid.  -->
    <sys:Double x:Key="{x:Static themes:MosaicTheme.DataGridColumnHeaderHeight}">38</sys:Double>

    <!--  Button  -->
    <Color x:Key="Button.Static.BackgroundColor">#FF1F1F1F</Color>
    <SolidColorBrush x:Key="Button.Static.Background" Color="{DynamicResource Button.Static.BackgroundColor}" />

    <Color x:Key="Button.Static.BorderColor">#FF3C3C3C</Color>
    <SolidColorBrush x:Key="Button.Static.Border" Color="{DynamicResource Button.Static.BorderColor}" />

    <Color x:Key="Button.MouseOver.BackgroundColor">#FF004681</Color>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="{DynamicResource Button.MouseOver.BackgroundColor}" />

    <Color x:Key="Button.MouseOver.BorderColor">#FF0078D7</Color>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="{DynamicResource Button.MouseOver.BorderColor}" />

    <Color x:Key="Button.Pressed.BackgroundColor">#FF00589D</Color>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="{DynamicResource Button.Pressed.BackgroundColor}" />

    <Color x:Key="Button.Pressed.BorderColor">#FF0078D7</Color>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="{DynamicResource Button.Pressed.BorderColor}" />

    <SolidColorBrush x:Key="SplitButton.Open.Background" Color="{DynamicResource Button.Pressed.BackgroundColor}" />
    <SolidColorBrush x:Key="SplitButton.Open.Border" Color="{DynamicResource Button.Pressed.BorderColor}" />
    <SolidColorBrush x:Key="SplitButton.Open.Foreground" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundColor}}" />

    <Color x:Key="Button.Disabled.BackgroundColor">#FF141414</Color>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="{DynamicResource Button.Disabled.BackgroundColor}" />

    <Color x:Key="Button.Disabled.BorderColor">#FF2A2A2A</Color>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="{DynamicResource Button.Disabled.BorderColor}" />

    <Color x:Key="Button.Disabled.ForegroundColor">#FF6A6A6A</Color>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="{DynamicResource Button.Disabled.ForegroundColor}" />

    <!--  ScrollBar  -->
    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ScrollBar.Static.Glyph" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="#FF141414" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#FF007ACC" />
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ScrollBar.Disabled.Thumb" Color="#FF262626" />

    <!--  ComboBox  -->
    <SolidColorBrush x:Key="ComboBox.Static.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="Transparent" />
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="Transparent" />

    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="#FF7EB4EA" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="#FF7EB4EA" />
    <LinearGradientBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF141414" />
        <GradientStop Offset="1.0" Color="#FF262626" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="#FF7EB4EA" />

    <LinearGradientBrush x:Key="ComboBox.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF094771" />
        <GradientStop Offset="1.0" Color="#FF003366" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="#FF569DE5" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="#FF569DE5" />
    <LinearGradientBrush x:Key="ComboBox.Pressed.Editable.Button.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FF094771" />
        <GradientStop Offset="1.0" Color="#FF003366" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="#FF569DE5" />

    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Foreground" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Border" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Border" Color="#FF2E2E2E" />

    <!--  ComboBoxItem  -->
    <SolidColorBrush x:Key="ComboBoxItem.Items.Hover.Background" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Hover.Border" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Selected.Background" Color="#FF094771" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Selected.Border" Color="#FF007ACC" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.SelectedHover.Background" Color="#FF0E639C" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.SelectedHover.Border" Color="#FF007ACC" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.SelectedNoFocus.Background" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.SelectedNoFocus.Border" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Focus.Border" Color="#FF007ACC" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.HoverFocus.Background" Color="#FF264F78" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.HoverFocus.Border" Color="#FF007ACC" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Disabled.Background" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Disabled.Border" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ComboBoxItem.Items.Disabled.Foreground" Color="#FF6A6A6A" />

    <!--  ListBox  -->
    <SolidColorBrush x:Key="Item.Static.Background" Color="Transparent" />
    <SolidColorBrush x:Key="Item.Static.Border" Color="Transparent" />
    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Item.MouseOver.Border" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="#FF0078D7" />
    <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="#FF106EBE" />
    <SolidColorBrush x:Key="Item.SelectedActive.Foreground" Color="White" />
    <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="#FF333333" />
    <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="Item.SelectedInactive.Foreground" Color="#FFF1F1F1" />

    <SolidColorBrush x:Key="ListBox.Static.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ListBox.Static.Border" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="ListBox.MouseOver.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="ListBox.MouseOver.Border" Color="#FF7EB4EA" />
    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FF2E2E2E" />

    <!--  ListView / GridView  -->
    <SolidColorBrush x:Key="ListBorder" Color="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderColor}}" />

    <SolidColorBrush x:Key="GridViewColumnHeader.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="GridViewColumnHeader.BorderBrush" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="GridViewColumnHeader.MouseOver.Border" Color="#FF0078D7" />
    <SolidColorBrush x:Key="GridViewColumnHeader.MouseOver.Background" Color="#FF262626" />
    <SolidColorBrush x:Key="GridViewColumnHeader.Pressed.Border" Color="#FF106EBE" />
    <SolidColorBrush x:Key="GridViewColumnHeader.Pressed.Background" Color="#FF333333" />
