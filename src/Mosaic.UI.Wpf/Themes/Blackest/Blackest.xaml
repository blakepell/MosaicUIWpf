<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Black/Black.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="{x:Static themes:MosaicTheme.WindowBackgroundColor}">#000002</Color>
    <Color x:Key="{x:Static themes:MosaicTheme.ControlBackgroundColor}">#0E1014</Color>
    <Color x:Key="{x:Static themes:MosaicTheme.ControlBackgroundLightColor}">#181A1F</Color>
    <Color x:Key="{x:Static themes:MosaicTheme.MessageBoxHeaderBackgroundColor}">#000002</Color>
    <Color x:Key="{x:Static themes:MosaicTheme.MessageBoxFooterBackgroundColor}">#0E1014</Color>
</ResourceDictionary>
