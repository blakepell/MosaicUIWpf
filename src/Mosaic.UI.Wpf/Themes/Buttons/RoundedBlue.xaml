<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="Button.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#222F75" />
        <GradientStop Offset="1" Color="#19265F" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#3D51A5" />

    <LinearGradientBrush x:Key="Button.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2A439E" />
        <GradientStop Offset="1" Color="#23388E" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#7489D7" />

    <LinearGradientBrush x:Key="Button.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2D48B2" />
        <GradientStop Offset="1" Color="#3652C0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#95A6E9" />

    <LinearGradientBrush x:Key="Button.Disabled.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1F295D" />
        <GradientStop Offset="1" Color="#1A2353" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#34447F" />

</ResourceDictionary>
