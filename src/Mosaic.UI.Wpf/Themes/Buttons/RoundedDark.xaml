<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="Button.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#44474D" />
        <GradientStop Offset="1" Color="#3F4247" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#232325" />

    <LinearGradientBrush x:Key="Button.MouseOver.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#004986" />
        <GradientStop Offset="1" Color="#00437B" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#00203B" />

    <LinearGradientBrush x:Key="Button.Pressed.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#00579B" />
        <GradientStop Offset="1" Color="#005AA0" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#00325E" />

    <LinearGradientBrush x:Key="Button.Disabled.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#383A3F" />
        <GradientStop Offset="1" Color="#37393D" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#2D2F32" />

</ResourceDictionary>
