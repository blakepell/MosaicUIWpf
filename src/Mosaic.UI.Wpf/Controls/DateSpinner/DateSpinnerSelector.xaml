<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <!--
        A single entry on a wheel. Containers remain focusable so ListBoxItem's standard mouse and touch selection
        works, but they are not tab stops, so Tab still moves between whole wheels.
    -->
    <Style TargetType="{x:Type controls:DateSpinnerSelectorItem}">
        <!--  Height is stamped on by DateSpinnerSelector.PrepareContainerForItemOverride, see the remarks there.  -->
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DateSpinnerSelectorItem}">
                    <Border
                        x:Name="ItemBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBackgroundBrush}}" />
                        </Trigger>
                        <!--  A value outside the permitted range stays on the wheel so its geometry never shifts, but it cannot be chosen.  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledForegroundBrush}}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  Values the spinner's range excludes, and the blank padding at each end, are not selectable.  -->
            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSpacer}" Value="True">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Opacity" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:DateSpinnerSelector}">
        <Setter Property="Height" Value="{Binding ViewportHeight, RelativeSource={RelativeSource Self}}" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:MosaicTheme.FontSizeNormal}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <!--
            Pixel scroll units keep the wheel's offset arithmetic exact while still virtualizing, so a range of ten
            thousand years realizes no more containers than a range of ten.
        -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding DisplayText}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                    <!--
                                        The centred value is called out with weight as well as color so the selection
                                        does not depend on color alone.
                                    -->
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type controls:DateSpinnerSelectorItem}}}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DateSpinnerSelector}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <!--  The selection band sits behind the entries and marks the centre of the wheel.  -->
                        <Border
                            x:Name="SelectionBand"
                            Height="{Binding ItemHeight, RelativeSource={RelativeSource TemplatedParent}}"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static themes:MosaicTheme.SelectionBackgroundBrush}}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />

                        <controls:InertiaScrollViewer
                            x:Name="PART_ScrollViewer"
                            AnimationDurationMilliseconds="{Binding ScrollAnimationDuration, RelativeSource={RelativeSource TemplatedParent}}"
                            Background="Transparent"
                            CanContentScroll="True"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            IsScrollAnimation="{Binding IsScrollAnimationEnabled, RelativeSource={RelativeSource TemplatedParent}}"
                            PanningMode="VerticalOnly"
                            PanningRatio="1"
                            WheelScrollDistance="{Binding ItemHeight, RelativeSource={RelativeSource TemplatedParent}}"
                            VerticalScrollBarVisibility="Hidden">
                            <ItemsPresenter SnapsToDevicePixels="True" />
                        </controls:InertiaScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SelectionBand" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.AccentBorderBrush}}" />
                            <Setter TargetName="SelectionBand" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SelectionBand" Property="Opacity" Value="0.5" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledForegroundBrush}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
