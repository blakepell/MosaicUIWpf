<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:converters="clr-namespace:Mosaic.UI.Wpf.Converters"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <converters:CornerRadiusToSurroundConverter x:Key="SettingsItemCornerRadiusConverter" />

    <!--  Default look for SettingsItem  -->
    <Style TargetType="{x:Type controls:SettingsItem}">
        <!--  Defaults (you can override per-instance)  -->
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsItem}">
                    <controls:ClipBorder CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="MainBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Icon  -->
                                    <Image
                                        Grid.Column="0"
                                        Width="{TemplateBinding IconSize}"
                                        Height="{TemplateBinding IconSize}"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding IconSource}" />

                                    <!--  Title & Description  -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{TemplateBinding Title}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                                            Text="{TemplateBinding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!--  Caller-provided content (e.g., ToggleButton)  -->
                                    <ContentPresenter
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="FooterBorder"
                                Grid.Row="1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.SettingsItemSeparatorBrush}}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SettingsItemCornerRadiusConverter}, ConverterParameter=Up, FallbackValue=0}">
                                <ContentPresenter Content="{TemplateBinding Footer}" />
                            </Border>
                        </Grid>
                    </controls:ClipBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Footer.Visibility, RelativeSource={RelativeSource TemplatedParent}}" Value="Collapsed">
                            <Setter TargetName="FooterBorder" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger SourceName="FooterBorder" Property="Visibility" Value="Visible">
                            <Setter TargetName="MainBorder" Property="CornerRadius" Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SettingsItemCornerRadiusConverter}, ConverterParameter=Down, FallbackValue=0}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
