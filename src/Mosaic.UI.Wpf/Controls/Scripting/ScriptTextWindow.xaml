<Window
    x:Class="Mosaic.UI.Wpf.Scripting.ScriptTextWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes"
    Width="584"
    Height="364"
    MinWidth="344"
    MinHeight="200"
    x:ClassModifier="internal"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mosaic.UI.Wpf;component/Themes/Native/ScrollBar.xaml" />
                <ResourceDictionary Source="/Mosaic.UI.Wpf;component/Themes/Native/ScrollViewer.xaml" />
                <ResourceDictionary Source="/Mosaic.UI.Wpf;component/Themes/Native/TextBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--  Transparent margin leaves room for the soft drop shadow around the rounded dialog (matches MessageBoxWindow).  -->
    <controls:ClipBorder
        Margin="12"
        Background="{DynamicResource {x:Static themes:MosaicTheme.MessageBoxFooterBackgroundBrush}}"
        BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}"
        BorderThickness="1"
        CornerRadius="6"
        SnapsToDevicePixels="True">
        <controls:ClipBorder.Effect>
            <DropShadowEffect
                BlurRadius="12"
                Direction="270"
                Opacity="0.35"
                ShadowDepth="2"
                Color="#000000" />
        </controls:ClipBorder.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Top portion: title bar, optional prompt and the text editor  -->
            <Border
                Grid.Row="0"
                Background="{DynamicResource {x:Static themes:MosaicTheme.MessageBoxHeaderBackgroundBrush}}"
                CornerRadius="5,5,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Title bar (drag region) with title text and close button only  -->
                    <Grid
                        Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="TitleTextBlock"
                            Grid.Column="0"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}"
                            FontSize="{DynamicResource {x:Static themes:MosaicTheme.FontSizeNormal}}"
                            Foreground="{DynamicResource {x:Static themes:MosaicTheme.WindowForegroundBrush}}"
                            TextTrimming="CharacterEllipsis" />

                        <Button
                            Grid.Column="1"
                            Click="OnCancelClick"
                            Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            IsTabStop="False"
                            Style="{DynamicResource {x:Static themes:MosaicTheme.WindowTitleBarCloseButtonStyle}}"
                            ToolTip="Close" />
                    </Grid>

                    <TextBlock
                        x:Name="PromptTextBlock"
                        Grid.Row="1"
                        Margin="16,8,16,0"
                        FontFamily="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}"
                        FontSize="{DynamicResource {x:Static themes:MosaicTheme.FontSizeNormal}}"
                        Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                        TextWrapping="Wrap" />

                    <TextBox
                        x:Name="Editor"
                        Grid.Row="2"
                        Margin="16,8,16,16"
                        HorizontalScrollBarVisibility="Disabled"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <!--  Bottom portion: buttons. 1px separator divides it from the top portion.  -->
            <Border
                Grid.Row="1"
                Background="{DynamicResource {x:Static themes:MosaicTheme.MessageBoxFooterBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorBrush}}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,5,5">
                <StackPanel
                    Margin="12,10,20,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <controls:AccentButton
                        x:Name="OkButton"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        AccentButtonType="ThemeAccent"
                        Click="OnOkClick"
                        Content="OK"
                        IsDefault="True" />
                    <controls:AccentButton
                        x:Name="CancelButton"
                        MinWidth="80"
                        Margin="8,0,0,0"
                        AccentButtonType="Gray"
                        Click="OnCancelClick"
                        Content="Cancel" />
                </StackPanel>
            </Border>
        </Grid>
    </controls:ClipBorder>
</Window>
