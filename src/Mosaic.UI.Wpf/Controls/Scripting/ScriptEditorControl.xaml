<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mosaic.UI.Wpf;component/Controls/ExecutionControl/ExecutionControl.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style
        x:Key="Mosaic.ScriptEditor.Button"
        BasedOn="{StaticResource MosaicExecutionButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="5" />
    </Style>
    <Style TargetType="{x:Type controls:ScriptEditorControl}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13.333" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ScriptEditorControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Margin="3"
                                Orientation="Horizontal"
                                Visibility="{TemplateBinding ToolBarVisibility}">
                                <Button
                                    AutomationProperties.Name="Save script"
                                    Command="{Binding SaveCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource Mosaic.ScriptEditor.Button}"
                                    ToolTip="Save (Ctrl+S)">
                                    <controls:AdaptiveImage Source="/Mosaic.UI.Wpf;component/Assets/vs-save-16.png" />
                                </Button>
                                <Separator Margin="4,4" Style="{DynamicResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                <!--  Script engine cannot pause a running script, so the pause button is hidden.  -->
                                <controls:ExecutionControl
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Script execution"
                                    ButtonPadding="5"
                                    PlayCommand="{Binding RunCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    PlayToolTip="Run (F5)"
                                    ShowPauseButton="False"
                                    StopCommand="{Binding StopCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    StopToolTip="Stop (F6)" />
                            </StackPanel>
                            <controls:SyntaxEditor
                                x:Name="PART_Editor"
                                Grid.Row="1"
                                Padding="5"
                                AutomationProperties.Name="JavaScript source"
                                FontFamily="{DynamicResource {x:Static themes:MosaicTheme.MonospaceFontFamily}}"
                                FontSize="{TemplateBinding FontSize}"
                                IsReadOnly="{TemplateBinding IsReadOnly}"
                                Language="JavaScript"
                                ShowLineNumbers="True" />
                            <TextBlock
                                Grid.Row="2"
                                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ErrorBrush}}"
                                Text="{Binding LastError.Message, RelativeSource={RelativeSource TemplatedParent}}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
