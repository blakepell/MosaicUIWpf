<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <BooleanToVisibilityConverter x:Key="MarkdownViewerBooleanToVisibilityConverter" />

    <!--
        The viewer's own style for its inner RichTextBox. It is set explicitly so an implicit
        RichTextBox or FlowDocument style from the host application or another UI framework
        (for example when Mosaic's native styles are off) cannot restyle the surface. Without it,
        a foreign template can repaint the background on focus or mouse over. Colors come from the
        viewer through template bindings, or from Mosaic tokens.
    -->
    <Style x:Key="MarkdownViewerRichTextBoxStyle" TargetType="{x:Type RichTextBox}">
        <Style.Resources>
            <Style TargetType="{x:Type FlowDocument}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
            </Style>
        </Style.Resources>
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.SelectionBackgroundBrush}}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="AllowDrop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RichTextBox}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsInactiveSelectionHighlightEnabled" Value="True" />
                    <Condition Property="IsSelectionActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.InactiveSelectionBackgroundBrush}}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:MarkdownViewer}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:MosaicTheme.FontSizeNormal}}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MarkdownViewer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <RichTextBox
                                x:Name="PART_RichTextBox"
                                Padding="{TemplateBinding Padding}"
                                CaretBrush="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource MarkdownViewerRichTextBoxStyle}"
                                HorizontalScrollBarVisibility="Disabled"
                                IsReadOnly="True"
                                IsUndoEnabled="False"
                                VerticalScrollBarVisibility="Auto" />

                            <!--  Find bar, modeled on the syntax editor's search panel.  -->
                            <Border
                                x:Name="PART_FindPanel"
                                Margin="0,0,18,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}"
                                BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlTextBackgroundBrush}}"
                                BorderThickness="1"
                                Cursor="Arrow"
                                Visibility="{Binding IsFindPanelOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource MarkdownViewerBooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">

                                    <TextBox
                                        x:Name="PART_FindTextBox"
                                        Width="150"
                                        Height="Auto"
                                        Margin="5,5,0,5"
                                        Focusable="True"
                                        Text="{Binding FindText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        MinWidth="52"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}"
                                        Opacity="0.7"
                                        Text="{Binding FindStatusText, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  Find next  -->
                                    <Button
                                        Width="30"
                                        Height="22"
                                        Margin="3,1,0,1"
                                        Padding="0"
                                        Command="{x:Static controls:MarkdownViewer.FindNextCommand}"
                                        ToolTip="Find next (Enter)">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M 4,6 L 8,10.5 L 12,6"
                                            Stroke="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.6" />
                                    </Button>

                                    <!--  Find previous  -->
                                    <Button
                                        Width="30"
                                        Height="22"
                                        Margin="1,1,0,1"
                                        Padding="0"
                                        Command="{x:Static controls:MarkdownViewer.FindPreviousCommand}"
                                        ToolTip="Find previous (Shift+Enter)">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M 4,10.5 L 8,6 L 12,10.5"
                                            Stroke="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.6" />
                                    </Button>

                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton
                                            Width="30"
                                            Height="22"
                                            Margin="1,0,0,0"
                                            Content="aA"
                                            Cursor="Hand"
                                            FontFamily="Consolas,Courier New,Courier"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            IsChecked="{Binding FindMatchCase, RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="Match case" />

                                        <ToggleButton
                                            Width="30"
                                            Height="22"
                                            Margin="1,0,0,0"
                                            Content="Ab"
                                            Cursor="Hand"
                                            FontFamily="Consolas,Courier New,Courier"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            IsChecked="{Binding FindWholeWords, RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="Match whole words" />

                                        <ToggleButton
                                            Width="30"
                                            Height="22"
                                            Margin="1,0,0,0"
                                            Content="a*"
                                            Cursor="Hand"
                                            FontFamily="Consolas,Courier New,Courier"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            IsChecked="{Binding FindUseRegex, RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="Use regular expressions" />
                                    </StackPanel>

                                    <!--  Close  -->
                                    <Button
                                        Width="30"
                                        Height="22"
                                        Margin="1,0,4,0"
                                        Padding="1"
                                        Command="{x:Static controls:MarkdownViewer.CloseFindPanelCommand}"
                                        ToolTip="Close (Esc)">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
                                            Stroke="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="1.6" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
