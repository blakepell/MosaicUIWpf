<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:converters="clr-namespace:Mosaic.UI.Wpf.Converters"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">
    <converters:IsNullOrWhiteSpaceToVisibilityConverter x:Key="LineGraphIsNullOrWhiteSpaceToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="LineGraphBooleanToVisibilityConverter" />

    <Style TargetType="{x:Type controls:LineGraph}">
        <!--  Every colour is a dynamic theme token so the graph follows a light/dark switch with no code.  -->
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}" />
        <Setter Property="AxisForeground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}" />
        <Setter Property="StrokeBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LineGraph}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!--  The title row is Auto, so when Title is empty the collapsed TextBlock gives its space back to the plot.  -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="PART_Title"
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontSize="{TemplateBinding TitleFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Title}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{TemplateBinding Title,
                                                             Converter={StaticResource LineGraphIsNullOrWhiteSpaceToVisibilityConverter}}" />

                            <!--  The plot is painted onto this canvas from code, so it must stretch to fill the row.  -->
                            <Canvas
                                x:Name="PART_Canvas"
                                Grid.Row="1"
                                Background="Transparent"
                                ClipToBounds="True" />

                            <ItemsControl
                                x:Name="PART_Legend"
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Focusable="False"
                                IsTabStop="False"
                                ItemsSource="{TemplateBinding Series}"
                                Visibility="{TemplateBinding ShowLegend,
                                                             Converter={StaticResource LineGraphBooleanToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type controls:LineGraphSeries}">
                                        <!--  Clicking a legend entry raises SeriesClicked, the same as clicking the line itself.  -->
                                        <StackPanel
                                            Margin="8,2"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            Orientation="Horizontal"
                                            ToolTip="{Binding Caption}">
                                            <Rectangle
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center"
                                                Fill="{Binding EffectiveBrush}"
                                                RadiusX="2"
                                                RadiusY="2" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:LineGraph}}}"
                                                Text="{Binding Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
