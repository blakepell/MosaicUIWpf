<Window
    x:Class="Mosaic.UI.Wpf.Controls.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Mosaic.UI.Wpf.Behaviors"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes"
    Title="Image"
    Width="800"
    Height="600"
    MinWidth="360"
    MinHeight="260"
    x:ClassModifier="internal"
    behaviors:WindowChromeBehavior.CaptionHeight="0"
    behaviors:WindowChromeBehavior.CornerRadius="8"
    behaviors:WindowChromeBehavior.GlassFrameThickness="0"
    behaviors:WindowChromeBehavior.IsEnabled="True"
    behaviors:WindowChromeBehavior.ResizeBorderThickness="5"
    behaviors:WindowChromeBehavior.RoundBorder="True"
    behaviors:WindowChromeBehavior.UseAeroCaptionButtons="True"
    Background="{DynamicResource {x:Static themes:MosaicTheme.WindowBackgroundBrush}}"
    Foreground="{DynamicResource {x:Static themes:MosaicTheme.WindowForegroundBrush}}"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            IsStretchButtonVisible="False"
            ShowIcon="False" />

        <controls:ImageViewer
            x:Name="Viewer"
            Grid.Row="1" />
    </Grid>
</Window>
