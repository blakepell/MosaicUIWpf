<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <BooleanToVisibilityConverter x:Key="Mosaic.ImageViewer.BoolToVisibility" />

    <!--  Flat glyph button used in the status bar (rotate, fit, zoom out / in).  -->
    <Style x:Key="Mosaic.ImageViewer.ToolButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBackgroundBrush}}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBorderBrush}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBackgroundBrush}}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBorderBrush}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledForegroundBrush}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Type controls:ImageViewer}" TargetType="{x:Type controls:ImageViewer}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.WindowBackgroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:MosaicTheme.FontSizeSmall}}" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ImageViewer}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Viewport  -->
                            <ScrollViewer
                                x:Name="PART_ScrollViewer"
                                Grid.Row="0"
                                Background="Transparent"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                                <Grid
                                    x:Name="PART_ImageHost"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Image
                                        x:Name="PART_Image"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Stretch="Fill" />
                                </Grid>
                            </ScrollViewer>

                            <!--  Status bar: resolution | file size ............ rotate fit  - [slider] +  zoom%  -->
                            <Border
                                Grid.Row="1"
                                Padding="10,3"
                                Background="{DynamicResource {x:Static themes:MosaicTheme.ControlBackgroundBrush}}"
                                BorderBrush="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorBrush}}"
                                BorderThickness="0,1,0,0"
                                Visibility="{TemplateBinding ShowStatusBar, Converter={StaticResource Mosaic.ImageViewer.BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{TemplateBinding ResolutionText}"
                                        ToolTip="Resolution" />

                                    <Rectangle
                                        Grid.Column="1"
                                        Width="1"
                                        Height="14"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorBrush}}" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{TemplateBinding FileSizeText}"
                                        ToolTip="File size" />

                                    <StackPanel
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Command="{x:Static controls:ImageViewer.RotateRightCommand}"
                                            Content="&#xE7AD;"
                                            Style="{StaticResource Mosaic.ImageViewer.ToolButton}"
                                            ToolTip="Rotate (Ctrl+R)" />
                                        <Button
                                            Command="{x:Static controls:ImageViewer.ZoomToFitCommand}"
                                            Content="&#xE9A6;"
                                            Style="{StaticResource Mosaic.ImageViewer.ToolButton}"
                                            ToolTip="Fit to window (Ctrl+0)" />
                                        <Button
                                            Command="{x:Static controls:ImageViewer.ActualSizeCommand}"
                                            Content="1:1"
                                            FontFamily="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource Mosaic.ImageViewer.ToolButton}"
                                            ToolTip="Actual size (Ctrl+1)" />

                                        <Rectangle
                                            Width="1"
                                            Height="14"
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorBrush}}" />

                                        <Button
                                            Command="{x:Static controls:ImageViewer.ZoomOutCommand}"
                                            Content="&#xE71F;"
                                            Style="{StaticResource Mosaic.ImageViewer.ToolButton}"
                                            ToolTip="Zoom out (Ctrl+Minus)" />
                                        <Slider
                                            x:Name="PART_ZoomSlider"
                                            Width="120"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            IsEnabled="{TemplateBinding HasImage}"
                                            IsMoveToPointEnabled="True"
                                            ToolTip="Zoom" />
                                        <Button
                                            Command="{x:Static controls:ImageViewer.ZoomInCommand}"
                                            Content="&#xE8A3;"
                                            Style="{StaticResource Mosaic.ImageViewer.ToolButton}"
                                            ToolTip="Zoom in (Ctrl+Plus)" />
                                        <TextBlock
                                            MinWidth="44"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:P0}}"
                                            TextAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
