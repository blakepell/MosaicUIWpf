<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <!--  Icon geometry is drawn against a 16x16 canvas and scaled by IconSize.  -->
    <Style x:Key="MosaicExecutionIconPathStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <!--  Muted state: the command reported that it cannot currently execute.  -->
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" Value="False">
                <Setter Property="Fill" Value="{Binding DisabledBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:ExecutionControl}}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MosaicExecutionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="PART_Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource {x:Static themes:MosaicTheme.ButtonCornerRadius}}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            x:Name="PART_ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBackgroundBrush}}" />
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBorderBrush}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBackgroundBrush}}" />
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBorderBrush}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlSelectedBorderBrush}}" />
                        </Trigger>
                        <!--  Muted state: the command reported that it cannot currently execute.  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="PART_Root" Property="Background" Value="Transparent" />
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="PART_ContentPresenter" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Type controls:ExecutionControl}" TargetType="{x:Type controls:ExecutionControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="PlayBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.SuccessBrush}}" />
        <Setter Property="PauseBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlForegroundBrush}}" />
        <Setter Property="StopBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ErrorBrush}}" />
        <Setter Property="DisabledBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlDisabledForegroundBrush}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ExecutionControl}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <StackPanel Orientation="{TemplateBinding Orientation}">

                            <!--  Play  -->
                            <Button
                                x:Name="PART_PlayButton"
                                Padding="{TemplateBinding ButtonPadding}"
                                Command="{TemplateBinding PlayCommand}"
                                CommandParameter="{TemplateBinding PlayCommandParameter}"
                                Foreground="{TemplateBinding PlayBrush}"
                                Style="{StaticResource MosaicExecutionButtonStyle}"
                                ToolTip="{TemplateBinding PlayToolTip}"
                                ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}">
                                    <Grid Width="16" Height="16">
                                        <Path Data="F1M3.777,1.084,3,1.5v12l.777.416,9-6V7.084Z" Style="{StaticResource MosaicExecutionIconPathStyle}" />
                                    </Grid>
                                </Viewbox>
                            </Button>

                            <!--  Pause  -->
                            <Button
                                x:Name="PART_PauseButton"
                                Padding="{TemplateBinding ButtonPadding}"
                                Command="{TemplateBinding PauseCommand}"
                                CommandParameter="{TemplateBinding PauseCommandParameter}"
                                Foreground="{TemplateBinding PauseBrush}"
                                Style="{StaticResource MosaicExecutionButtonStyle}"
                                ToolTip="{TemplateBinding PauseToolTip}"
                                ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}">
                                    <Grid Width="16" Height="16">
                                        <Path
                                            Data="F1M6.5,3.5v9h-3v-9Z M12.5,3.5v9h-3v-9Z"
                                            Opacity="0.75"
                                            Style="{StaticResource MosaicExecutionIconPathStyle}" />
                                        <Path Data="F1M12.5,3h-3L9,3.5v9l.5.5h3l.5-.5v-9ZM12,12H10V4h2ZM6.5,3h-3L3,3.5v9l.5.5h3l.5-.5v-9ZM6,12H4V4H6Z" Style="{StaticResource MosaicExecutionIconPathStyle}" />
                                    </Grid>
                                </Viewbox>
                            </Button>

                            <!--  Stop  -->
                            <Button
                                x:Name="PART_StopButton"
                                Padding="{TemplateBinding ButtonPadding}"
                                Command="{TemplateBinding StopCommand}"
                                CommandParameter="{TemplateBinding StopCommandParameter}"
                                Foreground="{TemplateBinding StopBrush}"
                                Style="{StaticResource MosaicExecutionButtonStyle}"
                                ToolTip="{TemplateBinding StopToolTip}"
                                ToolTipService.ShowOnDisabled="True">
                                <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}">
                                    <Grid Width="16" Height="16">
                                        <Path
                                            Data="F1M12.5,3.5v9h-9v-9Z"
                                            Opacity="0.75"
                                            Style="{StaticResource MosaicExecutionIconPathStyle}" />
                                        <Path Data="F1M12.5,3h-9L3,3.5v9l.5.5h9l.5-.5v-9ZM12,12H4V4h8Z" Style="{StaticResource MosaicExecutionIconPathStyle}" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPlayButton" Value="False">
                            <Setter TargetName="PART_PlayButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowPauseButton" Value="False">
                            <Setter TargetName="PART_PauseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowStopButton" Value="False">
                            <Setter TargetName="PART_StopButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
