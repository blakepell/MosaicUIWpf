<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <Style TargetType="{x:Type controls:InfoBubble}">
        <Setter Property="InfoBubbleBackground" Value="{DynamicResource {x:Static themes:MosaicTheme.AccentBrush}}" />
        <Setter Property="InfoBubbleForeground" Value="{DynamicResource {x:Static themes:MosaicTheme.SelectionForegroundBrush}}" />
        <Setter Property="InfoBubbleBorderBrush" Value="Transparent" />
        <Setter Property="InfoBubbleBorderThickness" Value="0" />
        <Setter Property="InfoBubbleCornerRadius" Value="8" />
        <Setter Property="InfoBubblePlacementMode" Value="TopRight" />
        <Setter Property="InfoBubbleMargin" Value="0" />
        <Setter Property="InfoBubbleFontFamily" Value="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}" />
        <Setter Property="InfoBubbleFontSize" Value="10" />
        <Setter Property="InfoBubbleFontWeight" Value="Normal" />
        <Setter Property="InfoBubbleMinWidth" Value="16" />
        <Setter Property="InfoBubbleMinHeight" Value="16" />
        <Setter Property="InfoBubblePadding" Value="4,2,4,2" />
        <Setter Property="IsInfoBubbleVisible" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBubble}">
                    <Grid>
                        <!--  Main Content  -->
                        <ContentPresenter
                            x:Name="PART_ContentPresenter"
                            Margin="{TemplateBinding InfoBubbleOverhangMargin}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />

                        <!--  InfoBubble  -->
                        <Border
                            x:Name="PART_InfoBubble"
                            MinWidth="{TemplateBinding InfoBubbleMinWidth}"
                            MinHeight="{TemplateBinding InfoBubbleMinHeight}"
                            Margin="{TemplateBinding InfoBubbleIndicatorMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{TemplateBinding InfoBubbleBackground}"
                            BorderBrush="{TemplateBinding InfoBubbleBorderBrush}"
                            BorderThickness="{TemplateBinding InfoBubbleBorderThickness}"
                            CornerRadius="{TemplateBinding InfoBubbleCornerRadius}">
                            <ContentPresenter
                                x:Name="PART_InfoBubbleContent"
                                Margin="{TemplateBinding InfoBubblePadding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding DisplayInfoBubbleContent}"
                                ContentTemplate="{TemplateBinding InfoBubbleContentTemplate}"
                                TextElement.FontFamily="{TemplateBinding InfoBubbleFontFamily}"
                                TextElement.FontSize="{TemplateBinding InfoBubbleFontSize}"
                                TextElement.FontWeight="{TemplateBinding InfoBubbleFontWeight}"
                                TextElement.Foreground="{TemplateBinding InfoBubbleForeground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Hide InfoBubble when computed visibility is false  -->
                        <Trigger Property="ComputedInfoBubbleVisibility" Value="False">
                            <Setter TargetName="PART_InfoBubble" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  IsDot mode - hide content presenter and use minimal sizing  -->
                        <Trigger Property="IsDot" Value="True">
                            <Setter TargetName="PART_InfoBubbleContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_InfoBubble" Property="MinWidth" Value="10" />
                            <Setter TargetName="PART_InfoBubble" Property="MinHeight" Value="10" />
                            <Setter TargetName="PART_InfoBubble" Property="CornerRadius" Value="5" />
                        </Trigger>

                        <!--  TopLeft placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="TopLeft">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Top" />
                        </Trigger>

                        <!--  Top placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="Top">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Top" />
                        </Trigger>

                        <!--  TopRight placement (default)  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="TopRight">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Top" />
                        </Trigger>

                        <!--  Right placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="Right">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Center" />
                        </Trigger>

                        <!--  BottomRight placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="BottomRight">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>

                        <!--  Bottom placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="Bottom">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>

                        <!--  BottomLeft placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="BottomLeft">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>

                        <!--  Left placement  -->
                        <Trigger Property="InfoBubblePlacementMode" Value="Left">
                            <Setter TargetName="PART_InfoBubble" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_InfoBubble" Property="VerticalAlignment" Value="Center" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
