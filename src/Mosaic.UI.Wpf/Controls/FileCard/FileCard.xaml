<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mosaic.UI.Wpf.Controls"
    xmlns:converters="clr-namespace:Mosaic.UI.Wpf.Converters"
    xmlns:themes="clr-namespace:Mosaic.UI.Wpf.Themes">

    <Style TargetType="{x:Type controls:FileCard}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FileCard}">
                    <!--  The outer margin leaves room for the drop shadow so the raise is not clipped.  -->
                    <Grid Margin="4" Background="{TemplateBinding Background}">
                        <!--
                            The raise and lower is driven from code (see FileCard.UpdateElevation) rather
                            than from trigger storyboards: the control owns the transform and shadow so a
                            single code path decides the resting, hovered, and pressed elevation.
                        -->
                        <Border
                            x:Name="PART_Card"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding CardBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Width="{TemplateBinding IconSize}"
                                    Height="{TemplateBinding IconSize}"
                                    VerticalAlignment="Center"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{TemplateBinding Icon}"
                                    Stretch="Uniform" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="FileNameText"
                                        FontWeight="SemiBold"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding FileName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{TemplateBinding FilePath}" />
                                    <TextBlock
                                        x:Name="FileSizeText"
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                                        Text="{TemplateBinding FileSizeText}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding FileSizeText, RelativeSource={RelativeSource TemplatedParent}, Converter={converters:IsNullOrWhiteSpaceToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Card" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlHoverBorderBrush}}" />
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Card" Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlPressedBorderBrush}}" />
                        </Trigger>

                        <!--  Missing file: the name is dimmed to match the error glyph already in the icon slot.  -->
                        <Trigger Property="FileExists" Value="False">
                            <Setter TargetName="FileNameText" Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextSecondaryForegroundBrush}}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Card" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
