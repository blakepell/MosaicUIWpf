    <!--  One completion entry: icon, name, and the return type right aligned.  -->
    <DataTemplate x:Key="ScriptCompletionItemTemplate">
        <DockPanel HorizontalAlignment="Stretch">
            <Path
                x:Name="Icon"
                Width="16"
                Height="16"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Data="{StaticResource ScriptCompletionPropertyGeometry}"
                DockPanel.Dock="Left"
                Fill="{DynamicResource ScriptCompletionPropertyBrush}"
                SnapsToDevicePixels="True"
                Stretch="Uniform" />
            <TextBlock
                x:Name="Detail"
                MaxWidth="150"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Foreground="{DynamicResource ScriptCompletionDetailBrush}"
                Text="{Binding Detail, Mode=OneTime}"
                TextAlignment="Right"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Method">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ScriptCompletionMethodGeometry}" />
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ScriptCompletionMethodBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Field">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ScriptCompletionFieldGeometry}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Global">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ScriptCompletionVariableGeometry}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Class">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ScriptCompletionClassGeometry}" />
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ScriptCompletionClassBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Module">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ScriptCompletionNamespaceGeometry}" />
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ScriptCompletionSnippetBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="Snippet">
                <Setter TargetName="Icon" Property="Data" Value="{StaticResource ScriptCompletionCodeGeometry}" />
                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ScriptCompletionSnippetBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.SelectionForegroundBrush}}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Replaces AvalonEdit's image + content template; PART_ListBox keeps the default list behavior.  -->
    <Style x:Key="ScriptCompletionListStyle" TargetType="{x:Type completion:CompletionList}">
        <Setter Property="FontSize" Value="{DynamicResource {x:Static themes:MosaicTheme.FontSizeSmall}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type completion:CompletionList}">
                    <completion:CompletionListBox x:Name="PART_ListBox" ItemTemplate="{StaticResource ScriptCompletionItemTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Separator line used between the metadata tool tip sections.  -->
    <Style x:Key="ScriptCompletionRuleStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlSeparatorBrush}}" />
    </Style>

    <!--  The metadata shown beside the selected entry (ScriptCompletionDescription).  -->
    <DataTemplate x:Key="ScriptCompletionDescriptionTemplate">
        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
            <!--  Foreground is set per TextBlock: the tool tip popup does not reliably inherit its Foreground.  -->
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                    Text="{Binding MemberType, Mode=OneTime}" />
                <TextBlock
                    Margin="5,0,0,0"
                    Foreground="{DynamicResource ScriptCompletionTypeBrush}"
                    Text="{Binding ReturnType, Mode=OneTime}" />
            </StackPanel>
            <Border Style="{StaticResource ScriptCompletionRuleStyle}" />
            <TextBlock
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                Text="{Binding Summary, Mode=OneTime}"
                TextWrapping="Wrap" />
            <Border x:Name="HintRule" Style="{StaticResource ScriptCompletionRuleStyle}" />
            <TextBlock
                x:Name="Hint"
                Foreground="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}"
                Text="{Binding Hint, Mode=OneTime}"
                TextAlignment="Left"
                TextWrapping="Wrap" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Hint, Mode=OneTime}" Value="">
                <Setter TargetName="HintRule" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        Parameter information (ScriptSignaturePopup). The rows are built in code with a signature or parameter
        as each element's DataContext; these triggers dim the overloads that do not match the arguments and
        bold the parameter being typed.
    -->
    <Style x:Key="ScriptSignaturePopupStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextBackgroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource {x:Static themes:MosaicTheme.FontSizeSmall}}" />
    </Style>

    <Style x:Key="ScriptSignatureRowStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:MosaicTheme.MonospaceFontFamily}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
        <Setter Property="Opacity" Value="0.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScriptSignatureParameterStyle" TargetType="{x:Type Span}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  The active overload's description and the current parameter's description.  -->
    <Style x:Key="ScriptSignatureTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static themes:MosaicTheme.FontFamily}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextForegroundBrush}}" />
    </Style>

    <!--  Implicit styles do not cascade, so extend the shared completion tool tip rather than replace it.  -->
    <Style BasedOn="{StaticResource {x:Type ToolTip}}" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource {x:Static themes:MosaicTheme.ControlTextBackgroundBrush}}" />
        <Setter Property="MaxWidth" Value="500" />
        <Setter Property="ContentTemplate" Value="{StaticResource ScriptCompletionDescriptionTemplate}" />
    </Style>
</ResourceDictionary>
