        supplied per theme by ScriptEditorSupport, everything else resolves from the Mosaic theme.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mosaic.UI.Wpf;component/Controls/AvalonEdit/CompletionWindow.xaml" />
    </ResourceDictionary.MergedDictionaries>

