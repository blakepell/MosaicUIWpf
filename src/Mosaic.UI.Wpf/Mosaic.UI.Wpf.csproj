<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyVersion>2026.8.13.1</AssemblyVersion>
    <FileVersion>2026.8.13.1</FileVersion>
    <PackageVersion>2026.8.13.1</PackageVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Mosaic UI for WPF</Title>
    <RepositoryUrl>https://github.com/blakepell/MosaicUIWpf</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/blakepell/MosaicUIWpf</PackageProjectUrl>
    <Copyright>2025-2026</Copyright>
    <Description>Mosaic UI for WPF Control Library</Description>
    <PackageTags>mosaic;wpf;controls</PackageTags>
    <PackageId>MosaicUIWpf</PackageId>
    <License>MIT</License>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>collage-48.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>	  
    <Authors>Blake Pell</Authors>
  </PropertyGroup>

